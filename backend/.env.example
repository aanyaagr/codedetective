PORT=5001

# Supabase (Project Settings → API). Server-side only — never put the service-role key in the frontend.
# Leave both empty to use the local development database (backend/data/local-db.json).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# REQUIRED in production: long random string that signs login tokens.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Allowed frontend URL(s), comma-separated. Any localhost port is also allowed in development.
FRONTEND_ORIGIN=http://localhost:3000

# "python3" on macOS/Linux, "python" on Windows
PYTHON_BIN=python3
CODE_TIMEOUT_MS=3000

# Optional: AI answers in the Detective AI Assistant. Without it, it answers from the case hints.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
